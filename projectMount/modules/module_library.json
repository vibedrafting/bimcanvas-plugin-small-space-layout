    {
      "id": "mod_murphy_bed",
      "name": "墨菲翻折床1500",
      "tags": ["sleep", "multipurpose"],
      "functions": ["sleep", "relax"],
      "size": { "width": 1600, "depth": 400 },
      "deployedSize": { "width": 1600, "depth": 2100 },
      "agent_config": {
        "morphology": { "strategy": "fixed" },
        "topology_rules": [
          "【必须】收起态贴墙（柜体深度 400mm）；展开态向房间内伸出至 2100mm，bounds 按展开态算",
          "【必须】展开态前方至少预留 600mm 下床净空，且不得压住主通道",
          "【必须】严格避让门的开启扇区域"
        ],
        "relation_rules": [
          "【建议】墨菲床区与休闲区时分复用：白天收起做休闲/工作，夜间放下做睡眠——软分区必须显式声明该复用关系",
          "【提示】床头侧用壁挂搁板替代独立床头柜，节省地面"
        ]
      },
      "description": "翻折床，收起后腾出地面实现时分复用",
      "svgPath": "assets/mod_murphy_bed.svg"
    },
